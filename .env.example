# Google Gemini API Key for Cloud Diarization (Recommended)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model (Options: gemini-flash-lite-latest, gemini-3.5-flash-lite, gemini-3.6-flash, gemini-flash-latest)
GEMINI_MODEL=gemini-flash-lite-latest

# Default Engine (Options: gemini, local)
MEMOSPLIT_ENGINE=gemini

# Hugging Face User Access Token (Optional: for local Pyannote CPU/GPU fallback)
# Request access at: https://hf.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your_huggingface_token_here

# Local Server Port
PORT=8080
